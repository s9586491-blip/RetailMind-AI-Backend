# RetailMind AI Backend Environment Variables

# Google Gemini API Key for Antigravity Agentic Reasoning
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Configuration
# Set to 'true' to allow all origins during development, or specify comma-separated domains
CORS_ALLOW_ALL=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://replit.com
